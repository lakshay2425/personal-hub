{
  "name": "personalHub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm run test:features",
    "test:features": "tsx --test \"features/**/*.test.ts\"",
    "test:content-ideas": "tsx --test \"features/content-ideas/**/*.test.ts\"",
    "test:dashboard": "tsx --test \"features/dashboard/**/*.test.ts\"",
    "test:job-search": "tsx --test \"features/job-search/**/*.test.ts\"",
