    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "lucide-react": "^1.28.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
