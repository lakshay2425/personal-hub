    "test:logger": "tsx --test \"features/logger/**/*.test.ts\"",
    "test:people": "tsx --test \"features/people/**/*.test.ts\"",
    "test:planner": "tsx --test \"features/planner/**/*.test.ts\"",
    "test:project-features": "tsx --test \"features/project-features/**/*.test.ts\"",
    "test:questions": "tsx --test \"features/questions/**/*.test.ts\"",
    "test:settings": "tsx --test \"features/settings/**/*.test.ts\"",
    "test:shared": "tsx --test \"features/shared/**/*.test.ts\"",
